# ===================================================================
# FixIt Java - Environment Configuration Example
# ===================================================================
# Copy this file to '.env' and substitute with your MongoDB Atlas credentials:
# NEVER commit your actual '.env' file with real credentials to GitHub.
# ===================================================================

# MongoDB Connection String (Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
MONGODB_DATABASE=fixit_db
